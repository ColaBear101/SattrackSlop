{
  "name": "satellite-ground-track",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ground track console: TLE to Keplerian elements, a day of SGP4 ground track, and Bangkok visibility above a 5 degree mask. Plus a Moon-centred console and an Earth-Moon libration-point view, which are served unchanged from public/.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ColaBear101/SattrackSlop.git"
  },
  "//": [
    "The Earth console is a Svelte 5 + Vite 8 + TypeScript app (src/). Every dependency is pinned exactly:",
    "satellite.js 6.0.1 and three 0.128.0 must not move, because the regression gate is bit-identical and",
    "the globe's palette is tuned to r128; typescript stays on 6.0.x because svelte-check does not accept 7.",
    "verification/ is CommonJS (its own package.json) and drives the built site over http.",
    "legacy/ is the pre-rewrite Earth console, kept until cutover as the A/B and calibration reference."
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch serve.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch serve.ts",
    "serve": "tsx serve.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "test:unit": "vitest run",
    "extract-data": "node scripts/extract-data.mjs",
    "legacy:manifest": "node scripts/legacy-manifest.mjs",
    "verify": "node verification/suites/verify.js",
    "planner": "node verification/suites/verify-planner.js",
    "advisor": "node verification/suites/verify-advisor.js",
    "evec": "node verification/suites/verify-evec.js",
    "custom": "node verification/suites/verify-custom.js",
    "mutate": "node verification/tools/mutate-new.js",
    "planner-ui": "node verification/suites/verify-planner-ui.js",
    "refresh": "node verification/suites/verify-refresh.js",
    "pov": "node verification/suites/verify-pov.js",
    "doppler": "node verification/suites/verify-doppler.js",
    "optical": "node verification/suites/verify-optical.js",
    "site": "node verification/suites/verify-site.js",
    "export": "node verification/suites/verify-export.js",
    "catalogue": "node verification/suites/verify-catalogue.js",
    "snapshot": "node verification/gate/snapshot.js",
    "gate": "npm run build && node verification/gate/regress.js --target new",
    "test": "npm run verify && npm run evec && npm run planner && npm run advisor && npm run gate && npm run refresh && npm run pov && npm run doppler && npm run optical && npm run site && npm run export && npm run catalogue && npm run custom && npm run timeline && npm run elements && npm run lifetime && npm run ar && npm run layout && npm run planner-ui",
    "moon": "node verification/suites/verify-moon.js",
    "moon:chain": "node verification/suites/verify-lunar-chain.js",
    "moon:bake": "node verification/tools/fetch-lunar-ephem.js",
    "timeline": "node verification/suites/verify-timeline.js",
    "globe": "node verification/suites/verify-globe.js",
    "elements": "node verification/suites/verify-elements.js",
    "lifetime": "node verification/suites/verify-lifetime.js",
    "decay-compare": "node verification/suites/verify-decay-compare.js",
    "ar": "node verification/suites/verify-ar.js",
    "ar-snap": "node verification/suites/verify-ar-snap.js",
    "layout": "node verification/suites/verify-layout.js",
    "axe": "node verification/suites/axe.js",
    "perf": "node verification/suites/perf.js",
    "build:shims": "node scripts/build-shims.mjs",
    "gate:lib": "node scripts/build-shims.mjs && node verification/gate/regress.js --mode lib",
    "check:deps": "node scripts/check-deps.mjs --self-test && node scripts/check-deps.mjs",
    "check:csp": "node scripts/csp.mjs --check",
    "slice": "node verification/suites/verify-slice.js",
    "visitor": "node verification/suites/verify-visitor.js",
    "golden": "node verification/gate/golden.js --target new",
    "golden:write": "node verification/gate/golden.js --write",
    "ab3d": "node verification/gate/ab3d.js --target new --fit",
    "ab3d:write": "node verification/gate/ab3d.js --write",
    "frames": "node verification/suites/verify-frames.js",
    "test:fast": "npm run check:deps && npm run check && npm run check:server && npm run build && npm run check:csp && npm run build:shims && npm run test:unit && node verification/run.js --fast --target new",
    "test:all": "npm run build && npm run check:csp && npm run build:shims && node verification/run.js",
    "gate:legacy": "node verification/gate/regress.js --target legacy"
  },
  "dependencies": {
    "@elysia/eden": "1.4.10",
    "@elysia/node": "1.4.6",
    "@elysia/static": "1.4.11",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@sinclair/typebox": "0.34.52",
    "elysia": "1.4.30",
    "file-type": "22.1.1",
    "openapi-types": "12.1.3",
    "satellite.js": "6.0.1",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@elysia/openapi": "1.4.16",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@types/three": "0.128.0",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
